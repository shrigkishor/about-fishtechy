# The homepage hero reel. Served from a media CDN rather than bundled — the file
# is ~84MB and has no place in the repo.
#
# NEXT_PUBLIC_ because it is read by a client component, which means Next inlines
# it at BUILD time: set it wherever the build runs, not only where it serves.
#
# Leaving it unset is supported. The hero renders without footage and keeps its
# own ground; nothing else on the page depends on it.
NEXT_PUBLIC_HERO_REEL_URL=https://media.example.com/path/to/hero-reel.mp4
